{
  "$defs": {
    "ExecutionTarget": {
      "enum": [
        "SIM",
        "PAPER",
        "LIVE"
      ],
      "title": "ExecutionTarget",
      "type": "string"
    },
    "OrderType": {
      "enum": [
        "MARKET",
        "LIMIT",
        "STOP",
        "STOP_LIMIT",
        "TRAILING_STOP",
        "CONDITIONAL"
      ],
      "title": "OrderType",
      "type": "string"
    },
    "Side": {
      "enum": [
        "BUY",
        "SELL",
        "SELL_SHORT",
        "BUY_TO_COVER"
      ],
      "title": "Side",
      "type": "string"
    },
    "TimeInForce": {
      "enum": [
        "DAY",
        "GTC",
        "IOC",
        "FOK",
        "GTD"
      ],
      "title": "TimeInForce",
      "type": "string"
    }
  },
  "$id": "https://rt365.example/contracts/events/order.command.v1.json",
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "title": "Account Id",
      "type": "string"
    },
    "approval_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Approval Id"
    },
    "authorised_at": {
      "format": "date-time",
      "title": "Authorised At",
      "type": "string"
    },
    "authorised_by": {
      "title": "Authorised By",
      "type": "string"
    },
    "command_id": {
      "title": "Command Id",
      "type": "string"
    },
    "correlation_id": {
      "title": "Correlation Id",
      "type": "string"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "execution_target": {
      "$ref": "#/$defs/ExecutionTarget"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "instrument_id": {
      "title": "Instrument Id",
      "type": "string"
    },
    "intent_hash": {
      "title": "Intent Hash",
      "type": "string"
    },
    "intent_id": {
      "title": "Intent Id",
      "type": "string"
    },
    "limit_price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Limit Price"
    },
    "order_type": {
      "$ref": "#/$defs/OrderType"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "quantity": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Quantity"
    },
    "side": {
      "$ref": "#/$defs/Side"
    },
    "stop_price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop Price"
    },
    "strategy_id": {
      "title": "Strategy Id",
      "type": "string"
    },
    "tenant_id": {
      "title": "Tenant Id",
      "type": "string"
    },
    "time_in_force": {
      "$ref": "#/$defs/TimeInForce"
    },
    "venue": {
      "title": "Venue",
      "type": "string"
    }
  },
  "required": [
    "command_id",
    "idempotency_key",
    "intent_id",
    "intent_hash",
    "decision_id",
    "approval_id",
    "tenant_id",
    "account_id",
    "strategy_id",
    "venue",
    "instrument_id",
    "side",
    "order_type",
    "quantity",
    "time_in_force",
    "policy_version",
    "correlation_id",
    "authorised_at",
    "authorised_by",
    "execution_target"
  ],
  "title": "order.command.v1",
  "type": "object"
}
